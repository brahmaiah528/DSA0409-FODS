        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "from scipy import stats\n",
        "\n",
        "# Programmatically create a sample customer_reviews.csv if it does not exist\n",
        "if not os.path.exists(\"customer_reviews.csv\"):\n",
        "    # Creating sample ratings between 1 and 5\n",
        "    sample_ratings = {\n",
        "        \"rating\": [5, 4, 5, 3, 4, 5, 2, 4, 5, 4, 3, 5, 4, 4, 5, 1, 5, 4, 3, 4]\n",
        "    }\n",
        "    pd.DataFrame(sample_ratings).to_csv(\"customer_reviews.csv\", index=False)\n",
        "    print(\"Successfully created 'customer_reviews.csv' with sample ratings.\\n\")\n",
        "\n",
        "data = pd.read_csv(\"customer_reviews.csv\")\n",
        "ratings = data[\"rating\"].dropna()\n",
        "\n",
        "confidence = 0.95\n",
        "mean = ratings.mean()\n",
        "sem = stats.sem(ratings)\n",
        "\n",
        "ci = stats.t.interval(\n",
        "    confidence, len(ratings) - 1,\n",
        "    loc=mean, scale=sem\n",
        ")\n",
        "\n",
        "print(\"Mean rating =\", mean)\n",
        "print(\"95% Confidence interval =\", ci)"
      ],
